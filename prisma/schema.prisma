generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// RBAC: Enum Role Pengguna
// ============================================================
enum Role {
  USER
  ADMIN
}

// ============================================================
// Status Verifikasi Laporan oleh Admin
// ============================================================
enum StatusLaporan {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================================
// Status Penukaran Reward
// ============================================================
enum StatusPenukaran {
  PENDING
  COMPLETED
  CANCELLED
}

// ============================================================
// Model User (Pengguna & Petugas DLH)
// - UUID sebagai Primary Key
// - Unique credentials: email, nomor HP, NIK
// - Relasi ke Laporan, Penukaran Reward, dan Artikel
// ============================================================
model User {
  id        String   @id @default(uuid())
  nama      String
  email     String   @unique
  noHp      String   @unique
  nik       String   @unique
  password  String
  role      Role     @default(USER)
  poin      Int      @default(0)
  createdAt DateTime @default(now())

  laporan        LaporanSampah[]
  penukaran      PenukaranReward[]
  artikelEdukasi ArtikelEdukasi[]
}

// ============================================================
// Model JenisSampah (Kategori Sampah)
// ============================================================
model JenisSampah {
  id        String   @id @default(uuid())
  namaJenis String   @unique

  laporan   LaporanSampah[]
}

// ============================================================
// Model Wilayah (Kecamatan DKI Jakarta)
// ============================================================
model Wilayah {
  id          String   @id @default(uuid())
  namaWilayah String   @unique

  laporan        LaporanSampah[]
  artikelEdukasi ArtikelEdukasi[]
}

// ============================================================
// Model LaporanSampah (Transaksi Pelaporan Masyarakat)
// ============================================================
model LaporanSampah {
  id            String        @id @default(uuid())
  berat         Float
  tanggalLapor  DateTime      @default(now())
  catatan       String?
  status        StatusLaporan @default(PENDING)
  adminNote     String?
  userId        String
  jenisSampahId String
  wilayahId     String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisSampah JenisSampah @relation(fields: [jenisSampahId], references: [id], onDelete: Restrict)
  wilayah     Wilayah     @relation(fields: [wilayahId], references: [id], onDelete: Restrict)

  foto        FotoSampah?

  @@unique([userId, jenisSampahId, wilayahId, tanggalLapor])
}

// ============================================================
// Model FotoSampah (Lampiran Bukti Foto Laporan)
// ============================================================
model FotoSampah {
  id        String        @id @default(uuid())
  imageUrl  String
  laporanId String        @unique

  laporan   LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)
}

// ============================================================
// Model Reward (Katalog Hadiah)
// - Menyimpan daftar hadiah/voucher yang bisa ditukarkan
// - poinDibutuhkan: minimum poin yang diperlukan
// - stok: jumlah reward yang tersedia
// ============================================================
model Reward {
  id             String            @id @default(uuid())
  namaReward     String
  deskripsi      String?
  poinDibutuhkan Int
  stok           Int               @default(0)
  imageUrl       String?
  createdAt      DateTime          @default(now())

  penukaran      PenukaranReward[]
}

model PenukaranReward {
  id            String          @id @default(uuid())
  userId        String
  rewardId      String
  poinDigunakan Int
  status        StatusPenukaran @default(PENDING)
  tanggalTukar  DateTime        @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
}

model KategoriArtikel {
  id           String           @id @default(uuid())
  namaKategori String           @unique
  deskripsi    String?

  artikel      ArtikelEdukasi[]
}

model ArtikelEdukasi {
  id         String   @id @default(uuid())
  judul      String
  slug       String   @unique
  ringkasan  String
  konten     String
  imageUrl   String?
  viewsCount Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kategoriId String
  authorId   String?
  wilayahId  String?

  kategori   KategoriArtikel @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  wilayah    Wilayah?        @relation(fields: [wilayahId], references: [id], onDelete: SetNull)
}
